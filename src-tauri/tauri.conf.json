{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpeakEx",
  "version": "0.1.0",
  "identifier": "com.rafaself.speakex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SpeakEx",
        "width": 960,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "publisher": "rafaself",
    "homepage": "https://github.com/rafaself/speakex",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Local-first desktop transcription app.",
    "longDescription": "SpeakEx is a local-first desktop transcription app for recording audio, transcribing it, and keeping history on your machine. It supports manual recording from the main window, tray access, and a global shortcut while keeping detailed transcription state inside the app.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "librsvg2"
        ]
      }
    }
  }
}
